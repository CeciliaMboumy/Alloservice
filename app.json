{
  "expo": {
    "name": "AlloService",
    "slug": "alloservice",
    "version": "1.0.0",
    "orientation": "portrait",
    "userInterfaceStyle": "light",
    "newArchEnabled": false,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.alloservice.app"
    },
    "android": {
      "package": "com.alloservice.app"
    },
    "web": {
      "bundler": "metro"
    },
    "plugins": [
      [
        "expo-image-picker",
        {
          "photosPermission": "Permettre à AlloService d'accéder à vos photos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Permettre à AlloService d'accéder à votre localisation."
        }
      ]
    ]
  }
}
